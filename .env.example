# Without it, analysis falls back to the local heuristic.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-20250514 or similar)
# ANTHROPIC_MODEL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Prefer service role for server writes (keep secret — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
